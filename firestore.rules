rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "joseluissalazar81@gmail.com" ||
        request.auth.token.email == "locampinotenisclub@hotmail.com"
      );
    }
    function isSignedIn() {
      return request.auth != null;
    }
    // Solo los campos permitidos pueden ser escritos
    function onlyFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    // ── ranking_atmas ──────────────────────────────────────────────
    // Lectura pública, escritura solo admin
    match /ranking_atmas/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── partidos_atmas ─────────────────────────────────────────────
    // Cualquier usuario autenticado puede crear un partido
    // Solo admin puede aprobar/rechazar (cambiar estado)
    // Nadie puede borrar excepto admin
    match /partidos_atmas/{docId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(["jugador1","jugador2","ganador","perdedor","estado","ts"])
        && request.resource.data.estado == "pendiente_rival";
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.estado == "pendiente_rival"
            && request.resource.data.estado == "pendiente_admin"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado","rivalConfirmo"]));
      allow delete: if isAdmin();
    }

    // ── inscripciones_atmas ────────────────────────────────────────
    match /inscripciones_atmas/{docId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(["nombre","torneo","ts"])
        && request.resource.data.estado == "pendiente_pago";
      allow update, delete: if isAdmin();
    }

    // ── reservas ──────────────────────────────────────────────────
    match /reservas/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(["nombre","fecha","hora","ts"]);
      allow update, delete: if isAdmin();
    }

    // ── slots_individuales ─────────────────────────────────────────
    match /slots_individuales/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── torneos_app, torneos_cuadro ────────────────────────────────
    match /torneos_app/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /torneos_cuadro/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── codigos_socio ──────────────────────────────────────────────
    match /codigos_socio/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── config_app ─────────────────────────────────────────────────
    match /config_app/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── progreso_alumnos ───────────────────────────────────────────
    match /progreso_alumnos/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── jugadores ──────────────────────────────────────────────────
    match /jugadores/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── notificaciones_admin ───────────────────────────────────────
    match /notificaciones_admin/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn();
    }

    // ── Bloquear todo lo demás ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
