rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── fotos_perfil ─────────────────────────────────────────────
    // Cada usuario solo puede subir/reemplazar su propia foto (nombrada
    // con su UID). Lectura pública para que se vea en el perfil sin
    // fricción, igual que los nombres del ranking.
    match /fotos_perfil/{uid}.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Bloquear todo lo demás ───────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
