{
  "version": 2,
  "builds": [
    {"src": "api/**/*.js", "use": "@vercel/node"},
    {"src": "index.html", "use": "@vercel/static"},
    {"src": "*.{js,css,png,jpg,svg,ico,json}", "use": "@vercel/static"},
    {"src": "img/**", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/(.*)", "dest": "/api/$1.js"},
    {"src": "/sw.js", "dest": "/sw.js", "headers": {"Cache-Control": "no-cache, no-store, must-revalidate", "Service-Worker-Allowed": "/"}},
    {"src": "/manifest.json", "dest": "/manifest.json", "headers": {"Cache-Control": "public, max-age=86400"}},
    {"src": "/(.*\\.(js|css|png|jpg|svg|ico|json))", "dest": "/$1"},
    {"src": "/(.*)", "dest": "/index.html"}
  ]
}