{
  "version": 2,
  "builds": [
    {"src": "api/**/*.js", "use": "@vercel/node"},
    {"src": "index.html", "use": "@vercel/static"},
    {"src": "*.{js,css,png,jpg,svg,ico,json}", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/(.*)", "dest": "/api/$1"},
    {"src": "/(.*\\.(js|css|png|jpg|svg|ico))", "dest": "/$1"},
    {"src": "/(.*)", "dest": "/index.html"}
  ]
}